@inproceedings{Sevgen_2026_Mobil,
author = {Sevgen, Eray},
title = {Mobil Lidar Nokta Bulutlar{\i}n{\i}n Denetimsiz Alan Adaptasyonu ile S{\i}n{\i}fland{\i}r{\i}lmas{\i}},
booktitle = {X. Uzaktan Alg{\i}lama ve Co{\u{g}}rafi Bilgi Sistemleri Sempozyumu},
year = {2026},
