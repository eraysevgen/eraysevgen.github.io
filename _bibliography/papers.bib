month = oct,
note = {15-17 Ekim},
bibtex_show = {true},
abstract = {Derin {\"o}{\u{g}}renme y{\"o}ntemleri 3B nokta bulutlar{\i}n{\i}n s{\i}n{\i}fland{\i}r{\i}lmas{\i}nda son y{\i}llarda elde etti{\u{g}}i ba{\c{s}}ar{\i}l{\i} sonu{\c{c}}lar ile dikkat {\c{c}}ekmektedir. Bununla birlikte, derin {\"o}{\u{g}}renme y{\"o}ntemlerinin etkin sonu{\c{c}}lar vermesi b{\"u}y{\"u}k miktarda etiketli e{\u{g}}itim verisine ba{\u{g}}l{\i}d{\i}r. Ancak 3B nokta bulutlar{\i}n{\i}n karma{\c{s}}{\i}k yap{\i}s{\i} ve nokta d{\"u}zeyinde etiketleme i{\c{s}}leminin zaman al{\i}c{\i} ve maliyetli olmas{\i}, {\"o}zellikle yeni veri setleri i{\c{c}}in yeterli miktarda veri olu{\c{s}}turulmas{\i}n{\i} g{\"u}{\c{c}}le{\c{s}}tirmektedir. Bu nedenle mevcut etiketli veri setlerinden {\"o}{\u{g}}renilen bilginin yeni ve etiketsiz veri setlerine aktar{\i}lmas{\i} {\"o}nemli bir ara{\c{s}}t{\i}rma konusu haline gelmi{\c{s}}tir. Bu t{\"u}r bilgi aktar{\i}m{\i}ndaki en temel g{\"u}{\c{c}}l{\"u}klerden biri, kaynak ve hedef veri da{\u{g}}{\i}l{\i}mlar{\i} aras{\i}daki da{\u{g}}{\i}l{\i}m fark{\i}d{\i}r. {\"O}zellikle farkl{\i} sens{\"o}rler, platformlar ve veri toplama ko{\c{s}}ullar{\i} ile elde edilen 3B nokta bulutlar{\i} aras{\i}nda geometrik yap{\i}, nokta yo{\u{g}}unlu{\u{g}}u ve verilerin da{\u{g}}{\i}l{\i}m{\i} a{\c{c}}{\i}s{\i}ndan farklar bulunmaktad{\i}r. Alan kaymas{\i} olarak tan{\i}mlanan bu durum, kaynak veri {\"u}zerinde e{\u{g}}itilen bir derin {\"o}{\u{g}}renme modelinin hedef veri {\"u}zerindeki genelleme ba{\c{s}}ar{\i}s{\i}n{\i} {\"o}nemli {\"o}l{\c{c}}{\"u}de azaltabilmektedir. Denetimsiz alan uyarlamas{\i}, etiketli bir kaynak alanda {\"o}{\u{g}}renilen bilginin, etiket bilgisi bulunmayan hedef alana aktar{\i}lmas{\i}n{\i} ama{\c{c}}lamaktad{\i}r. B{\"o}ylece, hem alan kaymas{\i}n{\i}n etkilerini azalt{\i}larak derin {\"o}{\u{g}}renme modelinin genelleme kapasitesi artacak hem de hedef alanda yeni etiketli veri olu{\c{s}}turma gereksinimini s{\i}n{\i}rlanm{\i}{\c{s}} olacakt{\i}r. Bu {\c{c}}al{\i}{\c{s}}mada, etiketsiz mobil LiDAR nokta bulutlar{\i}, etiketli hava LiDAR nokta bulutlar{\i}ndan {\"o}{\u{g}}renilen bilgi kullan{\i}larak s{\i}n{\i}fland{\i}r{\i}lmas{\i} ve iki veri alan{\i} aras{\i}ndaki bilgi aktar{\i}m{\i}n{\i}n denetimsiz alan adaptasyonu ile incelenmesi ama{\c{c}}lanm{\i}{\c{s}}t{\i}r. Elde edilen sonu{\c{c}}lara g{\"o}re, alan adaptasyonu sonras{\i}nda do{\u{g}}ruluk yakla{\c{s}}{\i}k 2 puan artm{\i}{\c{s}}, kesi{\c{s}}im birle{\c{s}}im oran{\i}nda ise yakla{\c{s}}{\i}k 6 puanl{\i}k bir art{\i}{\c{s}} meydana gelmi{\c{s}}tir. Bununla birlikte, performanstaki iyile{\c{s}}menin daha {\c{c}}ok nokta say{\i}lar{\i} y{\"u}ksek bask{\i}n s{\i}n{\i}flarda ger{\c{c}}ekle{\c{s}}ti{\u{g}}i, az say{\i}da {\"o}rne{\u{g}}e ait az{\i}nl{\i}k s{\i}n{\i}flar{\i}nda ise bir geli{\c{s}}me sa{\u{g}}lanmad{\i}{\u{g}}{\i} g{\"o}r{\"u}lm{\"u}{\c{s}}t{\"u}r. Bu sonu{\c{c}}lar, hava LiDAR verilerinden {\"o}{\u{g}}renilen bilginin mobil LiDAR verilerine aktar{\i}lmas{\i}nda denetimsiz alan uyarlamas{\i}n{\i}n uygulanabilirli{\u{g}}ine i{\c{s}}aret etmekte ve farkl{\i} sens{\"o}r ve platformlardan elde edilen 3B nokta bulutlar{\i} aras{\i}ndaki alan farkl{\i}l{\i}klar{\i}n{\i}n giderilmesine y{\"o}nelik gelecekteki {\c{c}}al{\i}{\c{s}}malar i{\c{c}}in bir temel olu{\c{s}}turmaktad{\i}r.}
}